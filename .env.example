# Copy to .env for local configuration. Keep credentials out of source control.
VLLM_API_KEY=

# Served models may run on separate GPU hosts.
STRATA_JUDGE_URL=http://127.0.0.1:8001/v1
STRATA_JUDGE_MODEL=
STRATA_CHALLENGER_URL=http://127.0.0.1:8000/v1
STRATA_CHALLENGER_MODEL=

# Audit and training runtime settings.
STRATA_CONFIG=configs/audit.toml
STRATA_LOG_LEVEL=INFO
STRATA_DEVICE=cuda
STRATA_OUTPUT_DIR=outputs
STRATA_SEED=7
STRATA_WORLDS=180
STRATA_VERIFICATION_FRACTION=0.25
STRATA_TOLERANCE=0.45

# Unbudgeted jobs retry transient HTTP failures. Audits cap physical attempts.
STRATA_HTTP_TIMEOUT=60
STRATA_HTTP_RETRIES=2
STRATA_RETRY_BACKOFF=0.5
STRATA_BREAKER_FAILURES=3
STRATA_BREAKER_RESET=30

# Local JSON experiment tracking.
STRATA_TRACKING=json
STRATA_EARLY_STOPPING_PATIENCE=3
STRATA_TRAIN_STEPS=500
STRATA_LORA_RANK=16
STRATA_MAX_LENGTH=2048
STRATA_LEARNING_RATE=0.00005
STRATA_GRADIENT_ACCUMULATION_STEPS=4
STRATA_DPO_BETA=0.1
STRATA_LORA_DROPOUT=0.05

# Weighted external-call units for audit budget accounting.
STRATA_AUDIT_BUDGET_UNITS=100
STRATA_JUDGE_COST=1
STRATA_CHALLENGER_COST=1
STRATA_VERIFICATION_COST=4
STRATA_ESCALATION_CONFIDENCE=0.9
STRATA_VERIFICATION_RESERVE=0.4
